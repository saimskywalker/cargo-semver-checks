SemverQuery(
    id: "exported_function_no_longer_variadic",
    human_readable_name: "exported function is no longer variadic",
    description: "A function exported via `#[no_mangle]` or `#[export_name]` is no longer C-variadic.",
    required_update: Major,
    lint_level: Deny,
    reference_link: Some(
        "https://doc.rust-lang.org/reference/items/functions.html#c-variadic-functions",
    ),
    query: r#"
    {
        CrateDiff {
            current {
                ffi_exported_function {
                    name @output
                    export_name @output @tag
                    c_variadic @filter(op: "!=", value: ["$true"])

                    span_: span @optional {
                        filename @output
                        begin_line @output
                        end_line @output
                    }
                }
            }
            baseline {
                ffi_exported_function {
                    export_name @filter(op: "=", value: ["%export_name"])
                    c_variadic @filter(op: "=", value: ["$true"])
                }
            }
        }
    }"#,
    arguments: {
        "true": true,
    },
    error_message: "An exported function is no longer C-variadic. Code that declares and calls this symbol as a variadic function now uses an incompatible calling convention, which is undefined behavior.",
    per_result_error_template: Some("{{name}} exported as {{export_name}} is no longer variadic in {{span_filename}}:{{span_begin_line}}"),
    witness: None,
)
